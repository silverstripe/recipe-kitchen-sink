{
    "name": "silverstripe/recipe-kitchen-sink",
    "type": "silverstripe-recipe",
    "description": "Internal testing Silverstripe CMS recipe for all modules, optional and suggested",
    "homepage": "https://github.com/silverstripe/recipe-kitchen-sink",
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.3",
        "silverstripe/recipe-plugin": "2.x-dev",
        "silverstripe/installer": "7.x-dev",
        "silverstripe/developer-docs": "7.x-dev",
        "silverstripe/totp-authenticator": "7.x-dev",
        "silverstripe/mfa": "7.x-dev",
        "silverstripe/gridfieldqueuedexport": "5.x-dev",
        "silverstripe/realme": "7.x-dev",
        "silverstripe/segment-field": "5.x-dev",
        "silverstripe/sharedraftcontent": "5.x-dev",
        "silverstripe/spamprotection": "6.x-dev",
        "silverstripe/lumberjack": "5.x-dev",
        "silverstripe/staticpublishqueue": "8.x-dev",
        "silverstripe/tagfield": "5.x-dev",
        "silverstripe/taxonomy": "5.x-dev",
        "silverstripe/textextraction": "6.x-dev",
        "silverstripe/userforms": "8.x-dev",
        "dnadesign/silverstripe-elemental": "7.x-dev",
        "dnadesign/silverstripe-elemental-userforms": "6.x-dev",
        "symbiote/silverstripe-advancedworkflow": "8.x-dev",
        "symbiote/silverstripe-gridfieldextensions": "6.x-dev",
        "symbiote/silverstripe-queuedjobs": "7.x-dev",
        "colymba/gridfield-bulk-editing-tools": "6.x-dev",
        "tractorcow/silverstripe-fluent": "9.x-dev",
        "silverstripe/dynamodb": "7.x-dev",
        "silverstripe/linkfield": "6.x-dev",
        "silverstripe/graphql": "7.x-dev",
        "silverstripe/campaign-admin": "4.x-dev",
        "silverstripe/environmentcheck": "5.x-dev"
    },
    "require-dev": {
        "silverstripe/frameworktest": "^3",
        "silverstripe/graphql-devtools": "4.x-dev",
        "silverstripe/recipe-testing": "^5",
        "mikey179/vfsstream": "^1.6"
    },
    "extra": {
        "project-files": [
            "app/*"
        ],
        "public-files": [
            "assets/*",
            "favicon.ico"
        ]
    },
    "config": {
        "process-timeout": 600,
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}